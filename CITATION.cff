cff-version: 1.2.0
message: "If you use this dataset, please cite it as below."
title: "Economics Journal Geographic Dispersion — catalogs and analysis panels"
type: dataset
authors:
  - family-names: "Yu"
    given-names: "Chiuyu"
    alias: "kochiuyu"
    affiliation: "The Chinese University of Hong Kong"
abstract: >
  Public research data for Geographic Dispersion work on economics
  (and related) journals: journal catalogs (core49, FT50, ABDC),
  journal-ranking freezes (ABS/AJG, CNRS, Handelsblatt/VWL, Tilburg/TISEM,
  FNEGE, ERIM Core), and analysis-ready editor / author-affiliation
  release panels. Scrapes and caches live in separate collector
  workspaces and are not part of this repository.
keywords:
  - economics
  - journals
  - editors
  - affiliations
  - geographic dispersion
  - FT50
  - ABDC
  - Tilburg
  - FNEGE
  - ERIM
license: CC-BY-4.0
repository-code: "https://github.com/kochiuyu/econ-journal-dispersion"
url: "https://github.com/kochiuyu/econ-journal-dispersion"
date-released: "2026-10-24"
